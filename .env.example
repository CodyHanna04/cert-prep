# Copy to .env.local for local development. Never commit real secrets.

# --- Postgres roles (see docs/11-auth-and-tenancy.md section 3) ---
# Used by docker/initdb/01-roles.sh on first start of the db container.
POSTGRES_PASSWORD=dev-postgres-superuser
OWNER_PASSWORD=dev-owner
APP_PASSWORD=dev-app
AUTH_PASSWORD=dev-auth
ADMIN_PASSWORD=dev-admin

# --- Connection strings used by the app / scripts ---
DATABASE_URL_OWNER=postgres://certprep_owner:dev-owner@127.0.0.1:5432/certprep
DATABASE_URL_APP=postgres://app_user:dev-app@127.0.0.1:5432/certprep
DATABASE_URL_AUTH=postgres://auth_app:dev-auth@127.0.0.1:5432/certprep
DATABASE_URL_ADMIN=postgres://admin_app:dev-admin@127.0.0.1:5432/certprep
# Tests run against a separate database in the same container.
TEST_DB_NAME=certprep_test

# --- App ---
APP_MODE=web
APP_ORIGIN=http://localhost:3000
PASSKEY_RP_ID=localhost
BETTER_AUTH_SECRET=dev-only-change-me-dev-only-change-me

# --- Homelab deployment (docker compose) ---
# Public origin of the site; PASSKEY_RP_ID must be exactly its host.
# APP_ORIGIN=https://study.codycodez.com
# PASSKEY_RP_ID=study.codycodez.com
# Where nginx can reach the web container (default: loopback).
# WEB_BIND=127.0.0.1
# Admin site (compose profile "admin"): your Tailscale login and an auth key for the sidecar node.
# ADMIN_TAILSCALE_LOGINS=you@example.com
# TS_AUTHKEY=tskey-auth-...
